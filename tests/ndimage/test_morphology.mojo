def _same(got: List[Float64], want: List[Float64]) raises:
    assert_equal(len(got), len(want))
    for i in range(len(want)):
        assert_almost_equal(got[i], want[i], atol=1e-13)


def _labels(got: List[Scalar[DType.int32]], want: List[Float64]) raises:
    for i in range(len(want)):
        assert_equal(Int(got[i]), Int(want[i]))


