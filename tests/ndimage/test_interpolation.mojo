"""Tests for `numax.ndimage`'s spline interpolation against SciPy: every
order from 0 to 5 in every interpolation mode through `map_coordinates`
at points inside and outside the input, `shift` and `zoom` (both
`grid_mode`s) with the prefilter, and the prefilter itself in three of
its boundary initializations."""

from max.gpu.host import DeviceContext
from std.testing import TestSuite, assert_almost_equal, assert_equal

from numax.core.tensor import Static
from numax.ndimage import (
    map_coordinates,
    shift,
    spline_filter,
    spline_filter1d,
    zoom,
)

comptime f64 = DType.float64


def _cpu() raises -> DeviceContext:
    return DeviceContext(api="cpu")


def _img() raises -> Static[f64, 6, 7]:
    return Static[f64, 6, 7](
        [
            0.0,
            0.429425538604203,
            0.6414709848078965,
            0.5474949866040544,
            0.10929742682568167,
            -0.6515278558960436,
            -1.6588799919401331,
            0.8833269096274834,
            1.0354497299884602,
            0.8463000876874145,
            0.325463180551151,
            -0.4607506707860176,
            -1.4055411020268311,
            -2.387766159183974,
            1.173847630878195,
            0.8957052121767204,
            0.33498815015590505,
            -0.40774569414324824,
            -1.211857890942719,
            -1.9661659367494548,
            -2.596164608835841,
            0.7273798802338298,
            0.19162585657241998,
            -0.42983614090849337,
            -1.021575772413588,
            -1.4999232575641008,
            -1.833454655720153,
            -2.0506855425976376,
            -0.04252044329485244,
            -0.4682771110644102,
            -0.7936910036334643,
            -0.9758146823277325,
            -1.0312666378723216,
            -1.0321625042720959,
            -1.0884586364866224,
            -0.477530117665097,
            -0.5089242746631385,
            -0.40554032557039194,
            -0.22941549819892593,
            -0.08488001191218453,
            -0.09301340128121094,
            -0.36200002322526137,
        ],
        _cpu(),
    )


def _coords() raises -> Static[f64, 2, 7]:
    return Static[f64, 2, 7](
        [
            -0.7,
            0.3,
            2.5,
            4.9,
            5.6,
            7.2,
            1.25,
            0.0,
            6.4,
            -1.3,
            3.3,
            2.0,
            8.1,
            0.75,
        ],
        _cpu(),
    )


def _close(got: List[Float64], want: List[Float64]) raises:
    assert_equal(len(got), len(want))
    for i in range(len(want)):
        assert_almost_equal(got[i], want[i], atol=1e-12)


def test_map_coordinates_matches_scipy() raises:
    _close(
        map_coordinates(_img(), _coords(), 0, "constant", 0.5).to_host(),
        [0.5, 0.5, 0.5, -0.22941549819892593, 0.5, 0.5, 1.0354497299884602],
