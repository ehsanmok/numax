def _w1() raises -> Static[f64, 4]:
    return Static[f64, 4]([1.0, -2.0, 0.5, 3.0], _cpu())


def _close(got: List[Float64], want: List[Float64]) raises:
    for i in range(len(want)):
        assert_almost_equal(got[i], want[i], atol=1e-13)


