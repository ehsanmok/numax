"""Tests for `numax.ndimage`'s filters against SciPy: `correlate` and
`convolve` in all five boundary modes with an even weight extent, an
origin shift, the 1-D forms, the separable `uniform_filter` and
`gaussian_filter` (derivative orders to 3) in two and three dimensions,
and the rank filters with odd and even footprints."""

from max.gpu.host import DeviceContext
from std.testing import TestSuite, assert_almost_equal

from numax.core.tensor import Static
from numax.ndimage import (
    convolve,
    convolve1d,
    correlate,
    correlate1d,
    gaussian_filter,
    gaussian_filter1d,
    maximum_filter,
    median_filter,
    minimum_filter,
    uniform_filter,
)

comptime f64 = DType.float64


def _cpu() raises -> DeviceContext:
    return DeviceContext(api="cpu")


