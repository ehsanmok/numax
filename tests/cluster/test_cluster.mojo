def test_inconsistent_and_fcluster_match_scipy() raises:
    var z = linkage(_x(), "average")
    # On a one-link level SciPy's variance `d^2 - d^2` is fused into an
    # FMA and leaves `5e-17`, a standard deviation of `7e-9`, where numax's
    # is exactly `0`; the coefficient divides only by a nonzero deviation,
    # so it agrees either way.
    var r = inconsistent(z).to_host()
    var want_r: List[Float64] = [
        0.7077624672162265,
        0.0,
        1.0,
        0.0,
        0.7478691663653476,
        7.254471791761221e-09,
        1.0,
        0.0,
        0.7825270666245354,
        0.0,
        1.0,
        0.0,
        0.8424950564048788,
        0.08480754445561205,
        2.0,
        0.7071067811865531,
        1.0036070819095204,
        0.4183874664542996,
        2.0,
        0.7071067811865467,
        1.1701408749638424,
        0.3785536158053079,
        2.0,
        0.7071067811865478,
        1.4576788950500992,
        0.028086551898583605,
        2.0,
        0.7071067811865482,
        1.2918939277616406,
        0.5402855240441319,
        3.0,
        0.9929323823810221,
        1.8059244540561514,
        0.46440704068397715,
        2.0,
        0.7071067811865454,
        2.016769394088283,
        0.2664498188737017,
        2.0,
        0.7071067811865529,
        2.2398285102011033,
        0.12645612266642026,
        3.0,
        1.1084424212308517,
    ]
    for i in range(len(want_r)):
        assert_almost_equal(r[i], want_r[i], atol=1e-7)
    _ints(
        fcluster(z, 1.2, "distance").to_host(),
        [1.0, 2.0, 4.0, 1.0, 7.0, 5.0, 6.0, 3.0, 5.0, 8.0, 1.0, 6.0],
    )
    _ints(
        fcluster(z, 4.0, "maxclust").to_host(),
        [1.0, 1.0, 2.0, 1.0, 3.0, 3.0, 3.0, 1.0, 3.0, 4.0, 1.0, 3.0],
    )
    _ints(
        fcluster(z, 0.9).to_host(),
        [1.0, 1.0, 1.0, 1.0, 3.0, 2.0, 3.0, 1.0, 2.0, 4.0, 1.0, 3.0],
    )


def main() raises:
    TestSuite.discover_tests[__functions_in_module()]().run()
