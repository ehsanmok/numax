def _book() raises -> Static[f64, 3, 2]:
    return Static[f64, 3, 2](
        [0.0006, 0.1494, 2.0494, 0.3552, 1.4244, 3.677], _cpu()
    )


def _book_empty() raises -> Static[f64, 4, 2]:
    return Static[f64, 4, 2](
        [0.0006, 0.1494, 2.0494, 0.3552, 1.4244, 3.677, 20.0, 20.0], _cpu()
