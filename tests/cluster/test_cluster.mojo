"""Tests for `numax.cluster` against SciPy: `vq`, `whiten`, `kmeans` and
`kmeans2` from a given codebook (with a code that empties, which `kmeans`
drops and `kmeans2` keeps), `linkage` under all seven methods from
observations and from condensed distances, `inconsistent`, and `fcluster`
under its three criteria, SciPy's numbering included."""

from max.gpu.host import DeviceContext
from std.testing import TestSuite, assert_almost_equal, assert_equal

from numax.core.tensor import Static
from numax.cluster import (
    fcluster,
    inconsistent,
    kmeans,
    kmeans2,
    linkage,
    vq,
    whiten,
)
from numax.spatial import pdist

comptime f64 = DType.float64


def _cpu() raises -> DeviceContext:
    return DeviceContext(api="cpu")


