"""Tests for the two-stage reductions `eigvalsh` (above `n = 256`) and
`svdvals` (from `n = 32`) take (`numax/linalg/_twostage.mojo`): each
spectrum against NumPy's LAPACK (the references are generated, not
transcribed), stage 1's band similar to its matrix at band widths that
leave a narrower last panel, and stage 2's `dsbtrd` on a band matrix."""

from std.builtin.sort import sort
from std.testing import TestSuite, assert_almost_equal, assert_true

from layout.tile_layout import row_major
from max.gpu.host import DeviceContext

from numax.core.tensor import Dynamic, Static, _dyn_shape
from numax.linalg import eigvalsh, svdvals
from numax.linalg.eigen import _tql, _RotationBatch
from numax.linalg._twostage import _dsbtrd_lower, _sy2sb

comptime f64 = DType.float64


def _lcg(count: Int, seed: Int) -> List[Float64]:
    var out = List[Float64](capacity=count)
    var x = seed
    for _ in range(count):
        x = (x * 1103515245 + 12345) % 2147483648
        out.append(Float64(x) / 2147483648.0 - 0.5)
    return out^


def _symmetric(n: Int, seed: Int) -> List[Scalar[f64]]:
    var v = _lcg(n * (n + 1) // 2, seed)
    var a = List[Scalar[f64]](length=n * n, fill=0)
    var k = 0
    for i in range(n):
        for j in range(i + 1):
            a[i * n + j] = v[k]
            a[j * n + i] = v[k]
            k += 1
    return a^


