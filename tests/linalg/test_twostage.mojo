def test_eigvalsh_two_stage_matches_lapack() raises:
    """`n = 300`: every eigenvalue within `1e-12` of NumPy's."""
    comptime n = 300
    var w = eigvalsh(Static[f64, n, n](_symmetric(n, 3))).to_host()
    var ref_w = _eig_ref()
    for i in range(n):
        assert_almost_equal(Float64(w[i]), ref_w[i], atol=1e-12)


def test_eigvalsh_reads_the_lower_triangle() raises:
    """Garbage above the diagonal does not reach the two-stage path."""
    comptime n = 300
    var a = _symmetric(n, 3)
    for i in range(n):
        for j in range(i + 1, n):
            a[i * n + j] = 99.0
    var w = eigvalsh(Static[f64, n, n](a^)).to_host()
    var ref_w = _eig_ref()
    for i in range(n):
        assert_almost_equal(Float64(w[i]), ref_w[i], atol=1e-12)


def test_svdvals_two_stage_matches_lapack() raises:
    """A tall `80 x 64`: every singular value within `1e-12`."""
    var v = _lcg(80 * 64, 9)
    var host = List[Scalar[f64]](capacity=80 * 64)
    for i in range(80 * 64):
        host.append(v[i])
    var s = svdvals(Static[f64, 80, 64](host^)).to_host()
    var ref_s = _sv_ref()
    for i in range(64):
        assert_almost_equal(Float64(s[i]), ref_s[i], atol=1e-12)


def test_float32_paths() raises:
    """At `float32` both routines agree with their `float64` answers to
    single precision."""
    comptime n = 300
    var a64 = _symmetric(n, 3)
    var a32 = List[Scalar[DType.float32]](capacity=n * n)
    for i in range(n * n):
        a32.append(Scalar[DType.float32](a64[i]))
    var w = eigvalsh(Static[DType.float32, n, n](a32^)).to_host()
    var ref_w = _eig_ref()
    for i in range(n):
        assert_almost_equal(Float64(w[i]), ref_w[i], atol=1e-4)


def _band_similar[n: Int](b: Int) raises:
    var ctx = DeviceContext(api="cpu")
    var v = _symmetric(n, 5)
    var a = Dynamic[f64, 2](row_major(_dyn_shape[2](n, n)), v.copy(), ctx)
    _sy2sb[f64, False](a, n, b, ctx)
    var h = a.to_host()
    var band = List[Scalar[f64]](length=n * n, fill=0)
    for i in range(n):
        for j in range(max(0, i - b), i + 1):
            band[i * n + j] = h[i * n + j]
            band[j * n + i] = h[i * n + j]
    var w0 = eigvalsh(Static[f64, n, n](v^, ctx)).to_host()
    var w1 = eigvalsh(Static[f64, n, n](band^, ctx)).to_host()
    for i in range(n):
        assert_almost_equal(Float64(w0[i]), Float64(w1[i]), atol=1e-12)


def test_stage1_band_widths() raises:
    """Stage 1's band keeps the spectrum at band widths whose last panel
    is narrower than the band (`100 = 3 * 32 + 4`, `97 = 4 * 24 + 1`)."""
    _band_similar[100](32)
    _band_similar[97](24)
    _band_similar[40](12)


def test_stage2_dsbtrd() raises:
    """`dsbtrd` on a band of half-width 16 gives the band's spectrum."""
    comptime n = 200
    comptime kd = 16
    var ctx = DeviceContext(api="cpu")
    var v = _symmetric(n, 7)
    for i in range(n):
        for j in range(n):
            if abs(i - j) > kd:
                v[i * n + j] = 0
    var ab = List[Scalar[f64]](length=(kd + 1) * n, fill=0)
    for j in range(n):
        for i in range(j, min(n, j + kd + 1)):
            ab[(i - j) + j * (kd + 1)] = v[i * n + j]
    var tri = _dsbtrd_lower[f64](n, kd, ab, kd + 1)
    var d = tri[0].copy()
    var e = tri[1].copy()
    var acc = _RotationBatch[f64, n, False, False](1, ctx)
    _tql[N=n, gpu=False, vectors=False](d, e, acc, ctx)
    sort(d)
    var w = eigvalsh(Static[f64, n, n](v^, ctx)).to_host()
    for i in range(n):
        assert_almost_equal(Float64(d[i]), Float64(w[i]), atol=1e-12)


def main() raises:
    TestSuite.discover_tests[__functions_in_module()]().run()
