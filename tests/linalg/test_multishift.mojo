def _matrix() raises -> Static[DType.float64, n, n]:
    """Dense pseudorandom entries in `[-0.5, 0.5)` from the LCG the
    reference script uses; its eigenvalues are at least `0.13` apart, so
    each is well conditioned and two correct solvers agree closely."""
    var v = List[Scalar[DType.float64]](capacity=n * n)
    var x = 5
    for _ in range(n * n):
        x = (x * 1103515245 + 12345) % 2147483648
        v.append(Float64(x) / 2147483648.0 - 0.5)
    return Static[DType.float64, n, n](v^)


def test_eigvals_match_lapack() raises:
    """Every eigenvalue is within `1e-9` of an unused NumPy one."""
    var e = eigvals(_matrix())
    var re = e.re.to_host()
    var im = e.im.to_host()
    var ref_re = _ref_re()
    var ref_im = _ref_im()
    var used = List[Bool](length=n, fill=False)
    for i in range(n):
        var best = -1
        var gap = 1e300
        for k in range(n):
            if not used[k]:
                var d = abs(Float64(re[i]) - ref_re[k]) + abs(
                    Float64(im[i]) - ref_im[k]
                )
                if d < gap:
                    gap = d
                    best = k
        used[best] = True
        assert_true(gap < 1e-9)


def test_schur_factors() raises:
    """`z t z^T = a`, `z^T z = I`, and `t` quasi-triangular with every
    surviving `2 x 2` block a complex pair."""
    var a = _matrix().to_host()
    var f = schur(_matrix())
    var t = f.t.to_host()
    var z = f.z.to_host()
    for i in range(n):
        for j in range(i - 1):
            assert_equal(Float64(t[i * n + j]), 0.0)
    for i in range(n - 1):
        if t[(i + 1) * n + i] != 0:
            # A 2 x 2 block: equal diagonal, off-diagonals of opposite sign.
            assert_almost_equal(
                Float64(t[i * n + i]),
                Float64(t[(i + 1) * n + i + 1]),
                atol=1e-12,
            )
            assert_true(
                Float64(t[(i + 1) * n + i]) * Float64(t[i * n + i + 1]) < 0
            )
    var zt = List[Float64](length=n * n, fill=0)
    for i in range(n):
        for k in range(n):
            var zik = Float64(z[i * n + k])
            for j in range(n):
                zt[i * n + j] += zik * Float64(t[k * n + j])
    for i in range(n):
        for j in range(n):
            var s = 0.0
            var o = 0.0
            for k in range(n):
                s += zt[i * n + k] * Float64(z[j * n + k])
                o += Float64(z[k * n + i]) * Float64(z[k * n + j])
            assert_almost_equal(s, Float64(a[i * n + j]), atol=1e-11)
            assert_almost_equal(o, 1.0 if i == j else 0.0, atol=1e-12)


def _hessenberg[dtype: DType](m: Int, seed: Int) -> List[Scalar[dtype]]:
    var h = List[Scalar[dtype]](length=m * m, fill=0)
    var x = seed
    for i in range(m):
        for j in range(m):
            x = (x * 1103515245 + 12345) % 2147483648
            if j >= i - 1:
                h[i * m + j] = Scalar[dtype](Float64(x) / 2147483648.0 - 0.5)
    return h^


def _check_driver[dtype: DType](m: Int, tol: Float64) raises:
    var h = _hessenberg[dtype](m, 11)
    var a = h.copy()
    var wr = List[Scalar[dtype]](length=m, fill=0)
    var wi = List[Scalar[dtype]](length=m, fill=0)
    var z = List[Scalar[dtype]](length=m * m, fill=0)
    for i in range(m):
        z[i * m + i] = 1
    assert_equal(_hseqr[dtype](True, True, m, h, wr, wi, z), 0)
    var zh = List[Float64](length=m * m, fill=0)
    for i in range(m):
        for k in range(m):
            var zik = Float64(z[i * m + k])
            for j in range(max(k - 1, 0), m):
                zh[i * m + j] += zik * Float64(h[k * m + j])
    var worst = 0.0
    for i in range(m):
        for j in range(m):
            var s = 0.0
            for k in range(m):
                s += zh[i * m + k] * Float64(z[j * m + k])
            worst = max(worst, abs(s - Float64(a[i * m + j])))
    assert_true(worst < tol)
    # Without `T`: the same spectrum, as power sums.
    var h2 = a.copy()
    var wr2 = List[Scalar[dtype]](length=m, fill=0)
    var wi2 = List[Scalar[dtype]](length=m, fill=0)
    var unused = List[Scalar[dtype]](length=1, fill=0)
    assert_equal(_hseqr[dtype](False, False, m, h2, wr2, wi2, unused), 0)
    var s1 = 0.0
    var s2 = 0.0
    var r1 = 0.0
    var r2 = 0.0
    for i in range(m):
        s1 += Float64(wr[i])
        s2 += Float64(wr[i]) ** 2 - Float64(wi[i]) ** 2
        r1 += Float64(wr2[i])
        r2 += Float64(wr2[i]) ** 2 - Float64(wi2[i]) ** 2
    assert_almost_equal(s1, r1, atol=tol * Float64(m))
    assert_almost_equal(s2, r2, atol=tol * Float64(m))


def test_driver_float64() raises:
    """`n = 300`: several AED windows and multishift sweeps."""
    _check_driver[DType.float64](300, 1e-12)


def test_driver_float32() raises:
    """The same driver at `float32`, where `eigvals` runs on Metal-sized
    data."""
    _check_driver[DType.float32](200, 2e-4)


def main() raises:
    TestSuite.discover_tests[__functions_in_module()]().run()
