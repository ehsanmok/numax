"""Tests for the multishift QR path `eigvals` and `schur` take above
`_NMIN = 75` (`numax/linalg/_multishift.mojo`, LAPACK's `dhseqr` ->
`dlaqr0`/`dlaqr3`/`dlaqr5`): the spectrum of a `160 x 160` nonsymmetric
matrix with 146 complex eigenvalues against NumPy's LAPACK (the reference
is generated, not transcribed), `schur`'s `a = z t z^T`, orthogonal `z`
and standard-form `t` there, and the host driver itself on random
Hessenberg matrices at `float64` and `float32`, with and without `T`."""

from std.testing import (
    TestSuite,
    assert_almost_equal,
    assert_equal,
    assert_true,
)

from numax.core.tensor import Static
from numax.linalg import eigvals, schur
from numax.linalg._multishift import _hseqr

comptime n = 160


