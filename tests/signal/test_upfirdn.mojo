"""Tests for `upfirdn` and `resample_poly` against SciPy.

`upfirdn` at three `(up, down)` pairs, including pure upsampling and pure
downsampling; `resample_poly` at five ratios, one of them unreduced
(`6/4`, which must equal `3/2`) and two of them pure integer factors,
all with SciPy's default Kaiser window; and `firwin` with a Kaiser `beta`.
"""

from std.math import sin
from std.testing import TestSuite, assert_almost_equal, assert_equal

from max.gpu.host import DeviceContext

from numax.core.tensor import Static
from numax.signal import firwin, resample_poly, upfirdn

comptime f64 = DType.float64


def _close(got: List[Float64], want: List[Float64]) raises:
    assert_equal(len(got), len(want))
    for i in range(len(want)):
        assert_almost_equal(got[i], want[i], atol=1e-12)


def _x() raises -> Static[f64, 30]:
    var values = List[Scalar[f64]](capacity=30)
    for i in range(30):
        values.append(sin(0.2 * Float64(i)) + 0.05 * Float64(i))
    return Static[f64, 30](values^, DeviceContext(api="cpu"))


def _h() raises -> Static[f64, 5]:
    return Static[f64, 5]([0.2, 0.5, 1.0, 0.5, 0.2], DeviceContext(api="cpu"))


def test_upfirdn_matches_scipy() raises:
    _close(
        upfirdn[up=3, down=2](_h(), _x()).to_host(),
