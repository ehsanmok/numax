def test_firwin_takes_a_kaiser_beta() raises:
    # scipy: signal.firwin(21, 0.3, window=("kaiser", 6.0))
    _close(
        firwin[f64, 21]([0.3], window="kaiser", beta=6.0).to_host(),
        [
            1.7405597664474114e-19,
            0.0015313379764884472,
            0.004521301522935082,
            0.003027360179751784,
            -0.010578855320135336,
            -0.030767033208445788,
            -0.029698332905349796,
            0.025513581370617974,
            0.13562567789749871,
            0.2507219029858273,
            0.30020611900162314,
            0.2507219029858273,
            0.13562567789749871,
            0.025513581370617974,
            -0.029698332905349796,
            -0.030767033208445788,
            -0.010578855320135336,
            0.003027360179751784,
            0.004521301522935082,
            0.0015313379764884472,
            1.7405597664474114e-19,
        ],
    )


def main() raises:
    TestSuite.discover_tests[__functions_in_module()]().run()
