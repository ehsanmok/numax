"""Tests for `convolve2d` and `correlate2d` against SciPy.

A `5 x 6` image against a `3 x 2` and a `2 x 4` kernel -- odd and even
kernel extents, which is where the `MODE_SAME` windows of the two
operations part -- in all three modes, under all three boundaries, and
with a nonzero `fillvalue`.
"""

from std.testing import TestSuite, assert_almost_equal, assert_equal

from max.gpu.host import DeviceContext

from numax.core.tensor import Static
from numax.signal import (
    MODE_FULL,
    MODE_SAME,
    MODE_VALID,
    convolve2d,
    correlate2d,
)

comptime f64 = DType.float64


def _a() raises -> Static[f64, 5, 6]:
    var values = List[Scalar[f64]](capacity=30)
    for i in range(5):
        for j in range(6):
            values.append(Float64((i * 7 + j * 3) % 11) - 5.0)
    return Static[f64, 5, 6](values^, DeviceContext(api="cpu"))


def _k() raises -> Static[f64, 3, 2]:
    return Static[f64, 3, 2](
        [1.0, -2.0, 0.5, 3.0, -1.0, 0.25], DeviceContext(api="cpu")
    )


def _k2() raises -> Static[f64, 2, 4]:
    return Static[f64, 2, 4](
        [1.0, 2.0, -1.0, 0.5, 0.0, -3.0, 1.0, 2.0], DeviceContext(api="cpu")
    )


def _close(got: List[Float64], want: List[Float64]) raises:
    assert_equal(len(got), len(want))
    for i in range(len(want)):
        assert_almost_equal(got[i], want[i], atol=1e-12)


def test_convolve2d_and_correlate2d_match_scipy() raises:
    _close(
        convolve2d[mode=MODE_FULL, boundary="fill"](_a(), _k()).to_host(),
        [
            -5.0,
            8.0,
            5.0,
            2.0,
            -12.0,
            7.0,
            2.0,
