"""Tests for `sosfreqz`, `sosfilt_zi` and `sosfiltfilt`.

Each against SciPy on an order-8 Butterworth in four sections -- the
order at which the `(b, a)` form starts to lose digits and the cascade
is the reason to exist -- plus the agreements the docstrings claim:
`sosfreqz` equals `freqz` of the same filter's `(b, a)` where both are
accurate, and a design's own `OUTPUT_SOS` feeds `sosfilt` directly and
agrees with `lfilter` of its `(b, a)` at an order where both are sound.
"""

from std.math import cos, sin
from std.testing import TestSuite, assert_almost_equal, assert_equal

from max.gpu.host import DeviceContext

from numax.core.tensor import Static
from numax.signal import (
    OUTPUT_SOS,
    butter,
    freqz,
    lfilter,
    sosfilt,
    sosfilt_zi,
    sosfiltfilt,
    sosfreqz,
)

comptime f64 = DType.float64


def _close(got: List[Float64], want: List[Float64], tol: Float64) raises:
    assert_equal(len(got), len(want))
    for i in range(len(want)):
        assert_almost_equal(got[i], want[i], atol=tol)


def _signal() raises -> Static[f64, 200]:
    var values = List[Scalar[f64]](capacity=200)
    for i in range(200):
        var t = Float64(i)
        values.append(sin(0.05 * t) + 0.3 * cos(1.3 * t) + 0.01 * t)
    return Static[f64, 200](values^, DeviceContext(api="cpu"))


def test_sosfiltfilt_matches_scipy() raises:
    # scipy: signal.sosfiltfilt(signal.butter(8, 0.2, output="sos"), x)
    var sos = butter[f64, 8, output=OUTPUT_SOS](0.2)
    _close(
        sosfiltfilt(sos, _signal()).to_host(),
