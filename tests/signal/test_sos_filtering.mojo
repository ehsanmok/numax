def test_sosfilt_zi_matches_scipy() raises:
    var sos = butter[f64, 8, output=OUTPUT_SOS](0.2)
    _close(
        sosfilt_zi(sos).to_host(),
        [
            0.00037159561619678024,
            -8.230239657196365e-05,
            0.005771205292456686,
            -0.0017223011141075557,
            0.0795011041957558,
            -0.03732368451953419,
            0.9143321352514879,
            -0.7085831884933758,
        ],
        1e-12,
    )


def test_sosfreqz_matches_scipy_and_freqz() raises:
    # scipy: signal.sosfreqz(sos, worN=8)
    var sos = butter[f64, 8, output=OUTPUT_SOS](0.2)
    var r = sosfreqz[worN=8](sos)
    _close(
        r.w.to_host(),
        [
            0.0,
            0.39269908169872414,
            0.7853981633974483,
            1.1780972450961724,
            1.5707963267948966,
            1.9634954084936207,
            2.356194490192345,
            2.748893571891069,
        ],
        1e-15,
    )
    _close(
        r.real.to_host(),
        [
            1.0000000000000009,
            -0.9867707743029095,
            -0.03857385883234889,
            -0.0026283172811574365,
            -1.4402465723909348e-05,
            2.1543984521253807e-06,
            8.293065171125844e-08,
            2.878706178266703e-10,
        ],
        1e-12,
    )
    _close(
        r.imag.to_host(),
        [
            0.0,
            0.16091734268599528,
            -0.13656124746894807,
            0.0016933009866818287,
            0.00012338707318212331,
            4.440690225876745e-06,
            6.863258231345351e-08,
            9.906865644758424e-11,
        ],
        1e-12,
    )
    var tf = butter[f64, 4](0.3)
    var s4 = butter[f64, 4, output=OUTPUT_SOS](0.3)
    var direct = freqz[worN=16](tf.b, tf.a)
    var cascade = sosfreqz[worN=16](s4)
    _close(cascade.real.to_host(), direct.real.to_host(), 1e-12)
    _close(cascade.imag.to_host(), direct.imag.to_host(), 1e-12)


def test_design_sections_feed_sosfilt() raises:
    var tf = butter[f64, 4](0.3)
    var sos = butter[f64, 4, output=OUTPUT_SOS](0.3)
    var direct = lfilter(tf.b, tf.a, _signal()).to_host()
    var cascade = sosfilt(sos, _signal()).to_host()
    _close(cascade, direct, 1e-12)


def main() raises:
    TestSuite.discover_tests[__functions_in_module()]().run()
